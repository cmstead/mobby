{
  "name": "mobby",
  "version": "1.0.0",
  "description": "A simple rotating timer for mob programming sessions.",
  "author": {
    "name": "Chris Stead",
    "email": "cmstead@gmail.com",
    "url": "https://chrisstead.net"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "playwright test",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.mobby.mobtimer",
    "productName": "Mobby the Mob Timer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
